# QMS testnet (chain 19480) — use a BURNER key, never a funded mainnet wallet
QMS_RPC=https://rpc.testnet.qms.finance
PRIVATE_KEY=0x...
MARKET_ADDRESS=0x...
MARKET_DEPLOY_BLOCK=0
# v0.1 has no finality layer (`finalized` = genesis) → act on confirmation depth
CONFIRMATIONS=3
